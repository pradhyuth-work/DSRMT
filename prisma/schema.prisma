generator client {
  provider = "prisma-client-js"
}

// Supabase Postgres. DATABASE_URL is the pooled connection used at runtime;
// DIRECT_URL is the session connection used by Prisma CLI commands.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InvoiceStatus {
  PAID
  PARTIAL
  UNPAID
}

enum PaymentMethod {
  CASH
  /// Kept for historical rows only — no longer offered when recording a new payment.
  UPI
  CHEQUE
  NET_BANKING
}

enum Role {
  admin
  stock
  agent
}

enum FulfilmentStatus {
  PENDING
  BILLED
  DISPATCHED
  CANCELLED
}

enum StockMovementType {
  RECEIVE
  ADJUST
  DISPATCH
  CANCEL_RETURN
}

model Product {
  id          String   @id @default(cuid())
  /// Human-facing sequential number (#1, #2, ...), shown and sorted on in the UI and used
  /// to match rows in bulk stock uploads. Distinct from the internal id. Inserting at an
  /// already-used code shifts that code and everything after it up by one (see lib/product-codes.ts).
  productCode Int      @unique
  name        String   @unique
  unitPrice   Float
  /// Never negative: enforced by a CHECK constraint in the migration.
  stockQty    Int      @default(0)
  createdAt   DateTime @default(now())

  invoiceItems   InvoiceItem[]
  stockMovements StockMovement[]
}

/// A route groups outlets and is assigned to at most one field agent — and an agent is
/// tied to at most one route in turn (agentId is unique), so a field agent's whole world
/// is exactly the outlets on that one route, never spread across several. Nullable
/// agentId: a route can exist unassigned.
model Route {
  id        String   @id @default(cuid())
  name      String
  agentId   String?  @unique
  createdAt DateTime @default(now())

  agent   Staff?   @relation(fields: [agentId], references: [id])
  outlets Outlet[]
}

/// Each outlet belongs to at most one route (nullable = not on any route yet, invisible
/// to every agent until assigned). An agent only ever sees and orders for outlets whose
/// route is assigned to them; admins are not restricted.
model Outlet {
  id        String   @id @default(cuid())
  name      String
  phone     String
  address   String   @default("")
  gstNumber String?
  routeId   String?
  /** Soft-hidden from the order-taking outlet pickers; nothing is deleted and every past report is unaffected. */
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  route    Route?              @relation(fields: [routeId], references: [id])
  invoices Invoice[]
  payments PaymentCollection[]

  @@index([routeId])
}

/// Sales staff and login users. Rows without a username cannot log in.
model Staff {
  id           String   @id @default(cuid())
  name         String
  phone        String
  username     String?  @unique
  passwordHash String?
  role         Role     @default(agent)
  active       Boolean  @default(true)
  /// Bumped on password reset so previously issued tokens stop working.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())

  invoices           Invoice[]           @relation("InvoiceOwner")
  billedInvoices     Invoice[]           @relation("InvoiceBilledBy")
  dispatchedInvoices Invoice[]           @relation("InvoiceDispatchedBy")
  cancelledInvoices  Invoice[]           @relation("InvoiceCancelledBy")
  payments           PaymentCollection[]
  stockMovements     StockMovement[]
  route              Route?
}

/// Invoice ids are human-readable, e.g. INV-1001. staffId is the order owner.
model Invoice {
  id               String           @id @default(cuid())
  /** The physical bill-book number, entered by hand when the order is billed — never auto-generated. */
  invoiceNumber    String?          @unique
  outletId         String
  staffId          String
  totalAmount      Float
  paidAmount       Float            @default(0)
  balanceDue       Float
  status           InvoiceStatus    @default(UNPAID)
  fulfilmentStatus FulfilmentStatus @default(PENDING)
  billedAt         DateTime?
  billedById       String?
  dispatchedAt     DateTime?
  dispatchedById   String?
  cancelledAt      DateTime?
  cancelledById    String?
  createdAt        DateTime         @default(now())

  outlet         Outlet              @relation(fields: [outletId], references: [id])
  staff          Staff               @relation("InvoiceOwner", fields: [staffId], references: [id])
  billedBy       Staff?              @relation("InvoiceBilledBy", fields: [billedById], references: [id])
  dispatchedBy   Staff?              @relation("InvoiceDispatchedBy", fields: [dispatchedById], references: [id])
  cancelledBy    Staff?              @relation("InvoiceCancelledBy", fields: [cancelledById], references: [id])
  items          InvoiceItem[]
  payments       PaymentCollection[]
  stockMovements StockMovement[]

  @@index([outletId, createdAt])
  @@index([staffId])
  @@index([fulfilmentStatus])
}

model InvoiceItem {
  id        String @id @default(cuid())
  invoiceId String
  productId String
  quantity  Int
  unitPrice Float
  subtotal  Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([invoiceId])
}

model PaymentCollection {
  id            String        @id @default(cuid())
  outletId      String
  staffId       String
  invoiceId     String?
  amount        Float
  paymentMethod PaymentMethod
  notes         String?
  createdAt     DateTime      @default(now())

  outlet  Outlet   @relation(fields: [outletId], references: [id])
  staff   Staff    @relation(fields: [staffId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([outletId])
  @@index([staffId])
}

/// Audit trail for every stock change. change is signed (+ in, - out).
model StockMovement {
  id        String            @id @default(cuid())
  productId String
  change    Int
  type      StockMovementType
  reason    String?
  invoiceId String?
  staffId   String
  createdAt DateTime          @default(now())

  product Product  @relation(fields: [productId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  staff   Staff    @relation(fields: [staffId], references: [id])

  @@index([productId, createdAt])
  @@index([invoiceId])
}
