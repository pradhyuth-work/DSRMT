# Copy to .env and fill in. Never commit .env.

# Supabase → Project Settings → Database → Connection string.
# Runtime: the transaction pooler (port 6543). Keep ?pgbouncer=true for Prisma.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Prisma CLI (generate/introspection) and scripts: the session pooler or direct connection (port 5432).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Signs login tokens (12h expiry). Use a long random value, at least 32 characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Used only by `npm run seed-admin` to create or reset an admin account.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
# Optional, used when the admin is first created.
ADMIN_NAME="Administrator"
ADMIN_PHONE=""
